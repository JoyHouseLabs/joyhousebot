# Private Operator Console. Keep this hostname behind VPN/access control and
# replace console.example.invalid plus certificate paths before enabling it.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name console.example.invalid;

    ssl_certificate     /etc/letsencrypt/live/console.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/console.example.invalid/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    client_max_body_size 16m;

    location = / { return 302 /ui/; }

    location ~ ^/control/v1/runs/[^/]+/events$ {
        proxy_pass http://127.0.0.1:18791;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location /control/v1/ {
        proxy_pass http://127.0.0.1:18791;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    location /ui/ {
        proxy_pass http://127.0.0.1:18791;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / { return 404; }
}
