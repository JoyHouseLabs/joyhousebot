[Unit]
Description=Porthouse public Runtime API
After=network-online.target porthouse-migrate.service
Wants=network-online.target
Requires=porthouse-migrate.service

[Service]
Type=simple
User=porthouseruntime
Group=porthouseruntime
WorkingDirectory=/opt/porthouse/current
EnvironmentFile=/etc/porthouse.env
Environment=PORTHOUSE_AUTO_MIGRATE=false
ExecStart=/opt/porthouse/venv/bin/porthouse api --surface public --config /etc/porthouse/config.json --host 127.0.0.1 --port 18790
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/porthouse

[Install]
WantedBy=multi-user.target
