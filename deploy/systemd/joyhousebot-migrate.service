[Unit]
Description=joyhousebot PostgreSQL schema migration
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
# API/Worker/Scheduler declare Requires=joyhousebot-migrate.service. Keep a
# successfully completed migration unit active so those long-running units do
# not lose their required dependency immediately after schema validation.
RemainAfterExit=yes
User=joyhousebotruntime
Group=joyhousebotruntime
WorkingDirectory=/opt/joyhousebot/current
EnvironmentFile=/etc/joyhousebot.env
Environment=JOYHOUSEBOT_AUTO_MIGRATE=true
ExecStart=/opt/joyhousebot/venv/bin/joyhousebot check --config /etc/joyhousebot/config.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/joyhousebot
