[Unit]
Description=JoyhouseBot scheduler and recovery loop
After=network-online.target joyhousebot-migrate.service
Wants=network-online.target
Requires=joyhousebot-migrate.service

[Service]
Type=simple
User=joyhouseruntime
Group=joyhouseruntime
WorkingDirectory=/opt/joyhousebot/current
EnvironmentFile=/etc/joyhousebot.env
Environment=JOYHOUSEBOT_AUTO_MIGRATE=false
ExecStart=/opt/joyhousebot/venv/bin/joyhousebot scheduler --config /etc/joyhousebot/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=35
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/joyhousebot

[Install]
WantedBy=multi-user.target
