<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/runtime_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_runtime_url"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/device_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_device_id"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/device_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_device_token"
            android:inputType="textPassword"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/host_revision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_host_revision"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/host_manifest_digest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_host_manifest_digest"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_start" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_stop" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/status_not_paired" />
    </LinearLayout>
</ScrollView>
