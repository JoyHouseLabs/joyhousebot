{
  "name": "@joyhousebot/node-extension-host",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated process supervisor for governed joyhousebot Node extensions",
  "type": "module",
  "main": "dist/index.js",
  "engines": {"node": ">=20"},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@joyhousebot/extension-sdk": "file:../../../sdks/node"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "license": "Apache-2.0"
}
