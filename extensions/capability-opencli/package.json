{
  "name": "@joyhousebot/capability-opencli",
  "version": "0.1.0",
  "private": true,
  "description": "Governed OpenCLI capabilities for the JoyhouseBot Node Extension Host",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "compile-catalog": "node dist/cli.js compile-catalog",
    "preflight": "node dist/cli.js preflight",
    "start": "node dist/worker.js"
  },
  "dependencies": {
    "@jackwener/opencli": "1.8.6",
    "@joyhousebot/extension-sdk": "file:../../sdks/node"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "license": "Apache-2.0"
}
