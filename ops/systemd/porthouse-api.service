[Unit]
Description=Porthouse API gateway
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Dedicated non-root service account, matching the non-root Dockerfile
# hardening. Create it and grant install/data paths before enabling:
#   useradd --system --home-dir /var/lib/porthouse --shell /usr/sbin/nologin porthouse
#   install -d -o porthouse -g porthouse /var/lib/porthouse
#   chown -R porthouse:porthouse /opt/porthouse
User=porthouse
Group=porthouse
WorkingDirectory=/opt/porthouse
Environment=PORTHOUSE_CONFIG_PATH=/opt/porthouse/config.json
EnvironmentFile=/etc/porthouse/porthouse.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/porthouse/.venv/bin/porthouse api --surface combined --config /opt/porthouse/config.json --host 127.0.0.1 --port 18790
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/porthouse /var/lib/porthouse

[Install]
WantedBy=multi-user.target
