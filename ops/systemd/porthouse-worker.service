[Unit]
Description=Porthousebot distributed worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Dedicated non-root service account; see porthouse-api.service for the
# useradd/chown bootstrap steps required before enabling these units.
User=porthouse
Group=porthouse
WorkingDirectory=/opt/porthouse
Environment=PORTHOUSE_CONFIG_PATH=/opt/porthouse/config.json
EnvironmentFile=/etc/porthouse/porthouse.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/porthouse/.venv/bin/porthouse worker --config /opt/porthouse/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/porthouse /var/lib/porthouse

[Install]
WantedBy=multi-user.target
