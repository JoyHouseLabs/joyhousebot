[Unit]
Description=joyhousebot distributed worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Dedicated non-root service account; see joyhousebot-api.service for the
# useradd/chown bootstrap steps required before enabling these units.
User=joyhousebot
Group=joyhousebot
WorkingDirectory=/opt/joyhousebot
Environment=JOYHOUSEBOT_CONFIG_PATH=/opt/joyhousebot/config.json
EnvironmentFile=/etc/joyhousebot/joyhousebot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/joyhousebot/.venv/bin/joyhousebot worker --config /opt/joyhousebot/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/joyhousebot /var/lib/joyhousebot

[Install]
WantedBy=multi-user.target
