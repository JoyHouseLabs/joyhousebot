[Unit]
Description=joyhousebot channel worker (external channel connections)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Dedicated non-root service account; see joyhousebot-api.service for the
# useradd/chown bootstrap steps required before enabling these units.
User=joyhousebot
Group=joyhousebot
WorkingDirectory=/opt/joyhousebot
Environment=JOYHOUSEBOT_CONFIG_PATH=/opt/joyhousebot/config.json
# Channel worker only submits runs and never calls LLM providers (see the
# channel-worker service in docker-compose.runtime.yml): inject the channel
# credentials this role needs, but do not put LLM provider API keys into the
# shared environment file on its behalf.
EnvironmentFile=/etc/joyhousebot/joyhousebot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/joyhousebot/.venv/bin/joyhousebot channel-worker --config /opt/joyhousebot/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/joyhousebot /var/lib/joyhousebot

[Install]
WantedBy=multi-user.target
