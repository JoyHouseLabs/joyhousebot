{
  "title": "JoyhouseBot Production Overview",
  "schemaVersion": 39,
  "tags": ["joyhousebot", "agent", "runtime", "slo"],
  "timezone": "browser",
  "refresh": "15s",
  "panels": [
    {"type":"stat","title":"API Up","targets":[{"expr":"joyhousebot_up"}]},
    {"type":"stat","title":"Online Workers","targets":[{"expr":"sum(joyhousebot_workers_total{status=\"online\"})"}]},
    {"type":"stat","title":"Queue Age","targets":[{"expr":"joyhousebot_queue_oldest_age_seconds"}]},
    {"type":"stat","title":"Task Claim P95","targets":[{"expr":"joyhousebot_task_claim_delay_ms_p95"}]},
    {"type":"timeseries","title":"Runs by Status","targets":[{"expr":"sum by (status) (joyhousebot_runs_total)"}]},
    {"type":"timeseries","title":"24h Run Outcomes","targets":[{"expr":"sum by (status) (joyhousebot_runs_24h_total)"}]},
    {"type":"timeseries","title":"24h Run Duration P95","targets":[{"expr":"joyhousebot_run_duration_ms_p95"}]},
    {"type":"timeseries","title":"Tasks by Status","targets":[{"expr":"sum by (status) (joyhousebot_tasks_total)"}]},
    {"type":"timeseries","title":"Provider Request Rate","targets":[{"expr":"sum by (provider,model,status) (rate(joyhousebot_provider_requests_total[5m]))"}]},
    {"type":"timeseries","title":"Provider Duration / TTFT P95","targets":[{"expr":"joyhousebot_provider_duration_ms_p95"},{"expr":"joyhousebot_provider_ttft_ms_p95"}]},
    {"type":"timeseries","title":"Provider Cost","targets":[{"expr":"sum by (provider,model) (joyhousebot_provider_cost_usd_total)"}]},
    {"type":"timeseries","title":"Actions","targets":[{"expr":"sum by (status) (joyhousebot_actions_total)"}]},
    {"type":"timeseries","title":"Approval / Reconciliation Wait","targets":[{"expr":"joyhousebot_approval_oldest_pending_seconds"},{"expr":"joyhousebot_reconciliation_oldest_active_seconds"}]},
    {"type":"timeseries","title":"Verifications","targets":[{"expr":"sum by (status,verifier_type) (joyhousebot_verifications_total)"}]},
    {"type":"timeseries","title":"Saga / GraphPatch / Eval","targets":[{"expr":"sum by (status) (joyhousebot_sagas_total)"},{"expr":"sum by (status) (joyhousebot_graph_patch_proposals_total)"},{"expr":"sum by (status) (joyhousebot_eval_runs_total)"}]},
    {"type":"timeseries","title":"Oldest Active State Machine","targets":[{"expr":"joyhousebot_oldest_active_seconds"}]},
    {"type":"timeseries","title":"Critical Events (24h)","targets":[{"expr":"sum by (event_type) (joyhousebot_critical_events_24h_total)"}]},
    {"type":"timeseries","title":"Works / Shares","targets":[{"expr":"sum by (status,visibility) (joyhousebot_works_total)"},{"expr":"sum by (status) (joyhousebot_work_shares_total)"}]},
    {"type":"timeseries","title":"Channel Outbox","targets":[{"expr":"sum by (channel,status) (joyhousebot_channel_outbox_total)"}]},
    {"type":"timeseries","title":"API Token Security","targets":[{"expr":"sum by (token_type,status) (joyhousebot_api_tokens_total)"},{"expr":"sum by (risk) (joyhousebot_api_token_risks_total)"}]}
  ]
}
